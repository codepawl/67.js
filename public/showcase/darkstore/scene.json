{
  "id": "darkstore",
  "title": "Dark store",
  "blurb": "A dark store: aisles of shelving packed for delivery.",
  "glb": "/showcase/darkstore/scene.glb",
  "hdri": "/showcase/darkstore/sky.hdr",
  "hdriOptions": { "intensity": 0.6, "rotation": 0, "showBackground": true, "backgroundBlur": 0.6 },
  "gltfOptions": { "maxTexturePixels": 67108864 },
  "exposure": 1,
  "renderer": {
    "ground": false,
    "hdr": true,
    "samples": 4,
    "environment": {
      "lightDirection": [-0.3, 0.85, 0.45],
      "keyColor": [2.2, 1.95, 1.6],
      "keyIntensity": 1,
      "fillIntensity": 0.4,
      "ambientIntensity": 0.8,
      "fogColor": [0.002, 0.003, 0.004],
      "fogDensity": 0.006
    }
  },
  "frame": { "fov": 34, "near": 0.25, "far": 300, "effects": { "ambientOcclusion": 0.6, "saturation": 1.05, "vignette": 0.3, "bloom": { "strength": 0.3, "threshold": 1, "radius": 1 } } },
  "credits": [
    { "model": "Shelving, crates, products and equipment (NVIDIA SimReady assets)", "author": "NVIDIA", "licence": "CC BY 4.0", "source": "https://docs.omniverse.nvidia.com/usd/latest/usd_content_samples/simready_assets.html" },
    { "model": "Store layout and remaining props", "author": "CodePawl", "licence": "MIT", "source": "https://github.com/codepawl/67.js" },
    { "model": "warm_restaurant_night (sky lighting, 512 x 256 average)", "author": "Poly Haven", "licence": "CC0", "source": "https://polyhaven.com/a/warm_restaurant_night" }
  ]
}
